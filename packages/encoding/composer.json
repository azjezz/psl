{
    "name": "php-standard-library/encoding",
    "description": "Binary-to-text encoding: Base64, Hex, and QuotedPrintable with streaming support",
    "type": "library",
    "license": "MIT",
    "homepage": "https://php-standard-library.dev",
    "keywords": [
        "encoding",
        "base64",
        "hex"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/io": "^6.0",
        "php-standard-library/str": "^6.0",
        "ext-mbstring": "*",
        "php-standard-library/default": "^6.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Encoding\\": "src/Psl/Encoding/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "php-standard-library/regex": "^6.0",
        "php-standard-library/secure-random": "^6.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Encoding\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "conflict": {
        "azjezz/psl": "*"
    }
}
