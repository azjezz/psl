{
    "name": "php-standard-library/binary",
    "description": "Typed functions for encoding and decoding binary data, replacing pack()/unpack() with a clear, type-safe API",
    "type": "library",
    "license": "MIT",
    "homepage": "https://php-standard-library.dev",
    "keywords": [
        "binary",
        "pack",
        "unpack",
        "endianness"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/default": "^6.0",
        "php-standard-library/io": "^6.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Binary\\": "src/Psl/Binary/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/math": "^6.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Binary\\Tests\\Unit\\": "tests/unit/"
        }
    }
}
