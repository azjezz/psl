{
    "name": "php-standard-library/ip",
    "description": "Immutable, binary-backed value object for IPv4 and IPv6 addresses with parsing, classification, and comparison",
    "type": "library",
    "license": "MIT",
    "homepage": "https://php-standard-library.dev",
    "keywords": [
        "ip",
        "ipv4",
        "ipv6",
        "networking"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/comparison": "^6.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\IP\\": "src/Psl/IP/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\IP\\Tests\\Unit\\": "tests/unit/"
        }
    }
}
