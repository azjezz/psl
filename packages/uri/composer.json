{
    "name": "php-standard-library/uri",
    "description": "RFC 3986 compliant URI parsing, construction, and manipulation",
    "type": "library",
    "license": "MIT",
    "homepage": "https://php-standard-library.dev",
    "keywords": [
        "uri",
        "rfc3986",
        "parsing"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/ip": "^6.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\URI\\": "src/Psl/URI/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "php-standard-library/str": "^6.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\URI\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "conflict": {
        "azjezz/psl": "*"
    }
}
