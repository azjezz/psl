{
    "name": "php-standard-library/dns",
    "description": "Async DNS resolver with connection pooling, EDNS0, DNS-over-TLS, and cross-platform system configuration",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "dns",
        "resolver",
        "async",
        "nameserver"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/cache": "^6.0",
        "php-standard-library/date-time": "^6.0",
        "php-standard-library/default": "^6.0",
        "php-standard-library/io": "^6.0",
        "php-standard-library/ip": "^6.0",
        "php-standard-library/network": "^6.0",
        "php-standard-library/process": "^6.0",
        "php-standard-library/punycode": "^6.0",
        "php-standard-library/tcp": "^6.0",
        "php-standard-library/tls": "^6.0",
        "php-standard-library/udp": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "php-standard-library/binary": "^6.0",
        "php-standard-library/iter": "^6.0",
        "php-standard-library/str": "^6.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\DNS\\": "src/Psl/DNS/"
        },
        "files": ["src/Psl/bootstrap.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\DNS\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.2.x-dev"
        }
    }
}
