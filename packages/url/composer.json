{
    "name": "php-standard-library/url",
    "description": "Strict URL type with scheme and authority validation, default port stripping, and URI/IRI conversion",
    "type": "library",
    "license": "MIT",
    "homepage": "https://php-standard-library.dev",
    "keywords": [
        "url",
        "parsing",
        "validation"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/uri": "^6.0",
        "php-standard-library/iri": "^6.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\URL\\": "src/Psl/URL/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\URL\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "conflict": {
        "azjezz/psl": "*"
    }
}
