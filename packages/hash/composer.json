{
    "name": "php-standard-library/hash",
    "description": "Cryptographic and non-cryptographic hashing with Algorithm enum, timing-safe comparison, and HMAC",
    "type": "library",
    "license": "MIT",
    "homepage": "https://php-standard-library.dev",
    "keywords": [
        "hash",
        "hmac",
        "cryptography"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/foundation": "^6.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Hash\\": "src/Psl/Hash/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Hash\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "conflict": {
        "azjezz/psl": "*"
    }
}
