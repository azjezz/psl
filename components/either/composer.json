{
    "name": "php-standard-library/either",
    "description": "General-purpose disjoint union type (Left/Right) for values with two possible types",
    "type": "library",
    "license": "MIT",
    "homepage": "https://php-standard-library.dev",
    "keywords": [
        "either",
        "monad",
        "union-type"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/comparison": "^6.0",
        "php-standard-library/option": "^6.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Either\\": "src/Psl/Either/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.0.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "php-standard-library/str": "^6.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Either\\Tests\\Unit\\": "tests/unit/"
        }
    }
}
